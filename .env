# SQLite for out-of-the-box run. For production swap to PostgreSQL per SoW:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/sales_dashboard"
# and set provider = "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# JWT signing secret (change in production)
JWT_SECRET="dev-secret-change-me-in-production-please-32chars"

# ── Telegram bot (Variant 2) ──────────────────────────────────────────
# Get a token from @BotFather, then run: npm run bot
TELEGRAM_BOT_TOKEN=""
# Bot username (without @) — used to build invite links in the admin panel.
TELEGRAM_BOT_USERNAME=""
# Public base URL where /uploads is reachable, so the bot can send module photos.
PUBLIC_BASE_URL="http://localhost:3000"
